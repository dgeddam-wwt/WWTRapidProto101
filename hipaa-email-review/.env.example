# HIPAA Email Review — configuration
# Never commit real values. Secrets are required in production (NODE_ENV=production).

NODE_ENV=development
PORT=8787

# Transport: dry-run (default, no network) | sendgrid (requires signed BAA)
EMAIL_TRANSPORT=dry-run

# Required only when EMAIL_TRANSPORT=sendgrid. Dispatch is refused unless the
# BAA confirmation flag is explicitly set, per AGENTS.md dependency policy.
SENDGRID_API_KEY=
SENDGRID_BAA_CONFIRMED=false

# Secure portal handoff. Must be https:// — plain-text/http links are rejected.
PORTAL_BASE_URL=https://portal.example.invalid/secure-message
PORTAL_TOKEN_SECRET=
PORTAL_TOKEN_TTL_SECONDS=900

# Salt for recipient_id_hash in audit entries (never store raw recipient address).
RECIPIENT_HASH_SALT=

# Append-only audit sink. Leave empty to keep the hash-chained log in memory only.
AUDIT_LOG_PATH=
