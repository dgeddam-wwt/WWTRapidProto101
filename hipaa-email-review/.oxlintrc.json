{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react", "typescript", "unicorn"],
  "categories": {
    "correctness": "error",
    "suspicious": "error"
  },
  "rules": {
    "no-console": "error",
    "eqeqeq": "error",
    "no-eval": "error",
    "react/react-in-jsx-scope": "off"
  },
  "overrides": [
    {
      "files": ["scripts/**", "tests/**"],
      "rules": { "no-console": "off" }
    }
  ],
  "ignorePatterns": ["dist", "node_modules"]
}
